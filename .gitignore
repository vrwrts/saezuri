# Reference clones — study only, never commit (CLAUDE.md).
reference/

# LLM-specific stuff
.claude

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
dist-server/

# Local env (real hosts/tokens live here, never committed)
.env
.env.local
.env.*.local

# Borrowed placeholder illustrations — local dev only. These are AvianVisitors
# CC-BY-NC-SA art used as dev placeholders; do not commit or ship them. Our own
# generic fallback silhouette is the one exception and IS committed.
/public/assets/illustrations/*
!/public/assets/illustrations/_fallback.png

# The empty-state nest illustration (public/assets/nest.webp) is borrowed AvianVisitors
# CC-BY-NC-SA art but, unlike the cutout placeholders above, it IS committed and shipped so
# the empty state works in built images. See LICENSE and public/assets/README.md for the
# licensing and attribution that shipping it requires.

# Cached reference-call recordings. Third-party CC-licensed audio fetched at
# runtime by the refresh service (and synthetic placeholder tones in dev, see
# src/dev/mockCalls.mjs) — never ours to commit.
/public/assets/calls/

# Layout manifest is a build artifact derived from whatever art is present
# locally (pipeline/build_masks.py). The app ships a built-in fallback manifest.
/public/layout-manifest.json

# Runtime artifacts the refresh service writes (snapshot + e-ink frames +
# downloaded species-name dictionaries). Not source; regenerated on every run.
/public/snapshot.json
/public/collage/
/public/species-dict/

# Python venv + caches for the pipeline tooling.
.venv/
__pycache__/

# Editor / OS
.DS_Store
*.log
.vite/
