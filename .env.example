# BirdNET-Go base URL (REQUIRED).
# Read by the Node refresh service, which is the only thing that talks to
# BirdNET-Go: it holds the detection SSE stream and publishes the static files
# the browser reads. nginx never proxies the API. Point it at your instance:
BIRDNETGO_URL=http://192.168.1.10:8080
#
# This must be reachable FROM INSIDE the container, and its host is forwarded to
# the upstream as the Host header (+ SNI for https). A LAN IP is simplest. A
# hostname works too, including one fronted by a reverse proxy or Cloudflare
# Tunnel that routes by Host/SNI. When BirdNET-Go also runs in Docker on this
# host, the cleanest option is to put Saezuri on its network and use the service
# name + internal port (e.g. http://birdnet-go:8080) — traffic stays local, no
# DNS, no round-trip out to Cloudflare. See docker-compose.yml for how.

# Optional auth token for a BirdNET-Go instance running with Security.PrivateMode.
# The refresh service sends it as "Authorization: Bearer <token>" on its own
# calls and on the SSE stream; the browser never receives it — it only ever reads
# the published static files. Leave unset for public LAN instances.
# BIRDNETGO_TOKEN=

# --- Optional: on-demand illustration generation ---
# Free downloads (below) are on by default and cover species someone has
# contributed art for. This fills in the rest: the refresh service holds
# BirdNET-Go's detection SSE stream and, the moment a species it can't download
# is heard, generates its kachō-e cutout. Until art exists the species is hidden
# (the collage only shows illustrated birds). Set an API key to enable
# generation; leave it unset to rely on downloads only. You pay for what it
# generates, with YOUR key.
# Persist the art with the named volume in docker-compose.yml so upgrades don't
# re-spend those API calls.
# GENERATE_API_KEY=

# Where those calls go. Any OpenAI-compatible chat/completions endpoint works,
# so this is also how you point Saezuri at a model on your own hardware
# (e.g. http://192.168.1.10:1234/v1 for LM Studio). Default: OpenRouter.
# GENERATE_API_URL=https://openrouter.ai/api/v1

# Which model draws the birds. The default is the one the illustration style was
# tuned against. Anything else is your experiment — the prompt asks for the bird
# on a flat magenta ground that Saezuri then cuts away, and a model that ignores
# that instruction produces a magenta rectangle instead of a cutout.
# GENERATE_MODEL=google/gemini-2.5-flash-image

# Seconds to wait between model calls, to stay within your provider's rate limit
# (default 6). This is the throughput knob: art is acquired one pose at a time, so
# this gap is the only thing pacing the calls. Lower it if your plan allows, raise
# it if you get throttled, 0 to remove the gap entirely. Needs GENERATE_API_KEY.
# GENERATE_SLEEP=6

# Prompt addenda for species the model keeps getting wrong, as a JSON object keyed
# by scientific name or slug. Defaults to _species-notes.json beside the art, so it
# lives in the persisted volume. Layered over the set bundled with the pipeline;
# only affects art Saezuri generates, never art downloaded from the repo.
# SPECIES_NOTES=/usr/share/nginx/html/assets/illustrations/_species-notes.json

# --- Free pre-made illustrations (on by default) ---
# A zero-cost alternative (or complement) to on-demand generation: the moment
# BirdNET-Go reports a species, the refresh service downloads its ready-made kachō-e
# cutout from the saezuri-illustrations repo (via the jsDelivr CDN) into the volume —
# no API key needed. Composes with GENERATE_API_KEY: download is tried first, and a
# species the repo doesn't have still falls back to generation. Art persists in the
# volume, so it's fetched once. To DISABLE downloads, set ILLUSTRATIONS_REPO empty.
# ILLUSTRATIONS_REPO=vrwrts/saezuri-illustrations
# Ref to pull art from (branch or release tag; default main = latest art).
# ILLUSTRATIONS_REF=main
# Override the base URL (advanced/testing; e.g. a local http.server for fixtures).
# ILLUSTRATIONS_BASE_URL=

# --- Reference calls (on by default) ---
# When a species is heard, the refresh service looks up a freely-licensed
# recording of its call, caches it in the volume, and publishes it so clicking a
# bird can play it. The browser only ever fetches the cached copy from this
# origin — it never talks to the archives.
#
# Wikimedia Commons needs no account or key, and only hosts free licences
# (CC0 / BY / BY-SA), so recordings are safe to cache and re-serve as long as
# the recordist is credited — which the UI does, on the species card.
#
# Comma-separated, tried in order. Set EMPTY to disable all outbound archive
# lookups (unlike the other list settings, empty here means off, not all).
# CALL_PROVIDERS=commons
# Cap species looked up per batch (default 4).
# CALLS_MAX_PER_CYCLE=4

# --- e-ink frame: /<window>.png (a chrome-free PNG of each window) ---
# Fixed image size, in device pixels; set to your panel (e.g. Waveshare 7.3"
# 7-color = 800x480). A width <= 700 uses the portrait packing.
# FRAME_WIDTH=800
# FRAME_HEIGHT=480
# Background fill: light --paper by default; use #17181c for a dark panel.
# FRAME_BG=#fcfcfb
# Per-tile drop shadow: 1 (default) or 0 to disable (some quantized panels muddy it).
# FRAME_SHADOW=1
# Which windows to render as PNGs (default all). E.g. FRAME_WINDOWS=7d for one panel.
# FRAME_WINDOWS=1h,12h,24h,7d,all

# --- Refresh cadence (rarely needs tuning) ---
# Min gap between snapshot/frame publishes triggered by new detections (ms).
# PUBLISH_DEBOUNCE_MS=20000
# Periodic republish so bounded windows shed aged-out detections (ms).
# AGING_INTERVAL_MS=120000
# How often to refresh the all-time summary — the one expensive endpoint (ms).
# SUMMARY_INTERVAL_MS=1800000

# --- Display languages ---
# Comma-list of the BirdNET-Go dictionary locales to publish for the browser to
# localize species names with (default: all 16 —
# cs,da,de,en,es,fi,fr,hu,it,lv,nb,nl,pl,pt,sk,sv). Narrow it to save disk and
# bandwidth, e.g. SPECIES_DICT_LOCALES=de,nl,en
# SPECIES_DICT_LOCALES=

# --- Paths (advanced; the container defaults are right for the image) ---
# Root the refresh service publishes into. Set ./public to run it in dev.
# FRAME_HTML_DIR=/usr/share/nginx/html
# Scratch directory for the illustration pipeline.
# CACHE_DIR=/var/cache/saezuri
# Interpreter and entry script for the vendored pipeline.
# PYTHON_BIN=python3
# WORKER_SCRIPT=/opt/saezuri/pipeline/worker.py
