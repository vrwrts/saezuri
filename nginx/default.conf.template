# Saezuri nginx config template. Copied verbatim at container start by
# nginx/entrypoint.sh (no ${...} placeholders left to substitute). The browser
# only ever talks to this origin, and this origin serves ONLY static files the
# refresh service publishes — nginx does not proxy BirdNET-Go at all.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    include /etc/nginx/saezuri-locations.conf;
}
