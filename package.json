{
  "name": "saezuri",
  "private": true,
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "description": "Self-hosted live bird collage for BirdNET-Go, in the AvianVisitors kachō-e style.",
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite",
    "build": "tsc --noEmit && vite build",
    "build:server": "esbuild src/server/refresh.ts --bundle --platform=node --format=esm --target=node22 --external:@napi-rs/canvas --outfile=dist-server/refresh.mjs",
    "refresh:dev": "pnpm build:server && node dist-server/refresh.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@napi-rs/canvas"
    ]
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "swr": "^2.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
